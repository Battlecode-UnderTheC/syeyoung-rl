# systemd user unit: cp to ~/.config/systemd/user/, then
#   systemctl --user daemon-reload && systemctl --user enable --now dragons-train
# (with `loginctl enable-linger` it keeps running after you log out)
[Unit]
Description=dragons-env self-play PPO (~/rl2/train)

[Service]
ExecStart=%h/rl2/train/deploy/run.sh
# any exit restarts it, including earlyoom's SIGTERM; `systemctl --user stop` still stops it
Restart=always
RestartSec=60
StandardOutput=append:%h/rl2/train/runs/train.log
StandardError=append:%h/rl2/train/runs/train.log

[Install]
WantedBy=default.target
